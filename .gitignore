diagnostico.txt
node_modules/

# El .env del servidor se crea allí a partir de .env.example y NO se versiona.
# Si alguna vez ves .env en `git status`, para y revisa este fichero antes de
# hacer commit: una vez dentro del historial, un secreto no se borra sin
# reescribirlo entero.
