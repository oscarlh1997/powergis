# ---------------------------------------------------------------------------
# PowerGIS · configuración del motor
#
# Copia a `.env` y rellena. NADA de esto va a git ni a la base de datos de
# WordPress. `powergis check-config` verifica que es apto para producción.
# ---------------------------------------------------------------------------

# -- entorno -----------------------------------------------------------------
ENV=production
DEBUG=false
LOG_LEVEL=INFO
LOG_JSON=true
ENGINE_VERSION=1.0.0

# -- dominios (Traefik) ------------------------------------------------------
ENGINE_HOST=motor.powergis.es
TILES_HOST=tiles.powergis.es
N8N_HOST=n8n.powergis.es
ACME_EMAIL=tu-correo@powergis.es

# -- base de datos -----------------------------------------------------------
POSTGRES_DB=powergis
POSTGRES_USER=powergis
POSTGRES_PASSWORD=          # obligatorio: genera uno largo
DATABASE_URL=postgresql+psycopg://powergis:CAMBIA@postgres:5432/powergis

# CUIDADO: esto es POR PROCESO, no por servicio.
# En KVM2 corren 6 procesos que abren pool (api×2, worker-reports×2,
# worker-etl×1, beat×1). El techo real es:
#
#     (DB_POOL_SIZE + DB_MAX_OVERFLOW) × procesos  ≤  max_connections
#     (3 + 4) × 6 = 42  ≤  50            ✔ KVM2
#
# Con los valores antiguos (10 + 20) × 6 = 180 contra max_connections=120:
# bajo carga, "FATAL: sorry, too many clients already". Si subes workers,
# rehaz la cuenta o sube max_connections en el compose.
DB_POOL_SIZE=3
DB_MAX_OVERFLOW=4
# KVM4: DB_POOL_SIZE=6 / DB_MAX_OVERFLOW=8 → (6+8)×8 = 112 ≤ 120

# -- redis / celery ----------------------------------------------------------
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# -- seguridad ---------------------------------------------------------------
# HMAC_SECRET debe ser EL MISMO valor que POWERGIS_HMAC_SECRET en wp-config.php.
# Genera con:  openssl rand -hex 32
HMAC_SECRET=
HMAC_WINDOW_SECONDS=300
INTERNAL_API_KEY=
ALLOWED_ORIGINS=https://powergis.es,https://www.powergis.es
WORDPRESS_BASE_URL=https://powergis.es
WORDPRESS_CALLBACK_PATH=/wp-json/saas/v1/projects/callback

# -- límites del tier gratuito ----------------------------------------------
# Con el modelo de almacén, el coste marginal de un informe básico es casi
# nulo: estos límites están para frenar bots, no clientes.
RATE_LIMIT_FREE_PER_HOUR=3
RATE_LIMIT_FREE_PER_DAY=5
REPORT_CACHE_TTL=3600
MAX_CHILDREN=8500

# -- fuentes de datos --------------------------------------------------------
INE_BASE_URL=https://servicios.ine.es/wstempus/js/ES
INE_RPS=2.0
INE_MAX_RETRIES=4

# En producción: extracto de Geofabrik cargado en PostGIS.
# La instancia pública de Overpass no aguanta carga comercial.
USE_LOCAL_OSM=true
OVERPASS_URL=https://overpass-api.de/api/interpreter
OSM_EXTRACT_PATH=/data/osm/spain-latest.osm.pbf

# API key gratuita en https://opendata.aemet.es/centrodedescargas/altaUsuario
AEMET_API_KEY=

CATASTRO_WFS_URL=https://ovc.catastro.meh.es/INSPIRE/wfsCP.aspx

# Sobreescritura de IDs de tabla del INE sin desplegar
# (el INE los renumera al republicar una operación):
# INE_TABLE_DEM_POP_TOTAL=2879
# ADRH_TABLE_ECO_INCOME_HOUSEHOLD_MEAN=30824

# -- LLM (AI Router de Hostinger, OpenAI, …) ---------------------------------
LLM_ENABLED=true
LLM_BASE_URL=https://api.nexos.ai/v1
LLM_API_KEY=
LLM_MODEL_FAST=gpt-4o-mini
LLM_MODEL_DEEP=gpt-4o

# -- stripe (el cobro lo inicia WordPress; aquí solo se verifica) -----------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# -- almacenamiento y copias -------------------------------------------------
TILES_DIR=/data/tiles
EXPORTS_DIR=/data/exports
BACKUP_RETENTION_DAYS=14
# En un CX23 (40 GB de disco) baja esto a 3. El override ya lo hace por ti.

# Destino EXTERNO del backup. Si lo dejas vacío, la copia vive sólo en el
# mismo servidor que quieres poder perder — que es como no tenerla.
#
# En Hetzner lo natural es su Object Storage (S3 compatible, mismo proveedor,
# tráfico interno). Se crea en la consola: Object Storage → Create bucket, y
# las credenciales en Security → Object Storage keys.
#
#   BACKUP_S3_ENDPOINT=https://fsn1.your-objectstorage.com   (Falkenstein)
#                      https://nbg1.your-objectstorage.com   (Núremberg)
#                      https://hel1.your-objectstorage.com   (Helsinki)
#
# Ponlo en la MISMA región que el servidor. Sirve igual Backblaze B2 o
# Cloudflare R2 si prefieres que la copia no viva donde vive el original.
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_KEY=
BACKUP_S3_SECRET=

# Frase de cifrado. Guárdala DONDE NO ESTÉ EL BACKUP: si la pierdes, la copia
# no se puede restaurar, y si está junto a la copia, el cifrado no protege de
# nada. Si defines esto y falta gpg, el backup falla en vez de guardarte el
# volcado en claro y decir que todo fue bien.
BACKUP_GPG_PASSPHRASE=

# -- n8n ---------------------------------------------------------------------
N8N_USER=admin
N8N_PASSWORD=
N8N_ENCRYPTION_KEY=

# -- túnel de Cloudflare (opcional, sólo para pruebas) -----------------------
# Publica este motor en un nombre público con HTTPS sin VPS ni IP fija:
#
#     docker compose -f docker-compose.yml -f docker-compose.tunnel.yml up -d
#
# El token sale de Cloudflare Zero Trust → Networks → Tunnels. Lee la cabecera
# de `docker-compose.tunnel.yml`: hay cuatro condiciones que cumplir antes de
# levantarlo, y la primera es no usar el HMAC_SECRET del entorno de desarrollo.
TUNNEL_TOKEN=

# -- observabilidad ----------------------------------------------------------
SENTRY_DSN=
